# Install with: crontab -e
# Set an absolute checkout path and keep the state directory outside that checkout.
# Europe/Copenhagen observes daylight-saving changes; these run at 06:17 and 18:17 local time.
CRON_TZ=Europe/Copenhagen
AEROEVENTS_STATE_DIR=/srv/aeroevents-state
17 6,18 * * * /bin/bash /srv/aeroevents/scripts/cron/collect-and-publish.sh >>/srv/aeroevents-state/cron.log 2>&1
