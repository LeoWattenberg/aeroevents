---
import CalendarExplorer from "../components/CalendarExplorer.astro";
import SourceStatus from "../components/SourceStatus.astro";
import { toCalendarDataset } from "../components/catalog-adapter";
import { sitePath } from "../components/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getBuildMetadata,
  getCategories,
  getOccurrences,
  getOrganizers,
  getPublishedEvents,
  getSources,
} from "../lib/catalog";

const [events, occurrences, organizers, categories, sources, metadata] = await Promise.all([
  getPublishedEvents(),
  getOccurrences(),
  getOrganizers(),
  getCategories(),
  getSources(),
  getBuildMetadata(),
]);
const dataset = toCalendarDataset(events, occurrences, organizers, categories, sources, metadata);
---

<BaseLayout title="Det sker på Ærø" canonicalPath="/">
  <section class="hero page-width" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span aria-hidden="true">Anno</span> Hele øens kalender</p>
      <h1 id="hero-title"><span>Hvad sker der</span><br /><em>på Ærø?</em></h1>
      <p class="lead">Find koncerter, fællesskaber, møder, gudstjenester og alt det andet, vi kan mødes om.</p>
      <div class="hero-actions">
        <a class="button" href="#kalender">Se kalenderen <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={sitePath("/indsend/")}>Få et arrangement med <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="map-card">
      <div class="aero-flag" aria-hidden="true"></div>
      <img
        src={sitePath("/images/aero-blaeu-1665.webp")}
        alt="Historisk kort over Ærø fra 1665"
        width="1800"
        height="1155"
        fetchpriority="high"
      />
      <figcaption>
        <span>Ærø tegnet af Joan Blaeu</span>
        <small>1665</small>
      </figcaption>
    </figure>
  </section>

  <section class="calendar-wrap page-width" id="kalender">
    <CalendarExplorer dataset={dataset} />
    <SourceStatus dataset={dataset} />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 35rem;
    grid-template-columns: minmax(20rem, 0.85fr) minmax(24rem, 1.15fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .hero .eyebrow span {
    padding: 0.18rem 0.4rem;
    border: 1px solid currentcolor;
    font-family: var(--serif);
    font-size: 0.62rem;
    font-style: italic;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  h1 em {
    color: var(--green);
    font-weight: inherit;
  }

  h1 > span {
    white-space: nowrap;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    align-items: center;
    margin-top: 2rem;
  }

  .text-link {
    color: var(--green);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .map-card {
    position: relative;
    margin: 0;
    padding: clamp(0.65rem, 1.6vw, 1rem);
    border: 1px solid rgb(65 57 38 / 35%);
    background: #e4d5b5;
    box-shadow: 0 1.6rem 4rem rgb(54 48 32 / 18%);
    rotate: 1.1deg;
  }

  .map-card::before,
  .map-card::after {
    position: absolute;
    z-index: 2;
    width: 4rem;
    height: 1.1rem;
    background: rgb(246 236 203 / 82%);
    box-shadow: 0 1px 2px rgb(44 38 25 / 12%);
    content: "";
  }

  .map-card::before {
    top: -0.45rem;
    left: 12%;
    rotate: -4deg;
  }

  .map-card::after {
    right: 10%;
    bottom: -0.4rem;
    rotate: 3deg;
  }

  .map-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.38;
    border: 1px solid rgb(73 61 38 / 28%);
    filter: sepia(0.14) saturate(0.85) contrast(0.95);
    object-fit: cover;
  }

  .aero-flag {
    position: absolute;
    z-index: 3;
    top: 1.7rem;
    right: -0.8rem;
    width: 2.6rem;
    height: 6.8rem;
    border: 2px solid var(--paper-strong);
    background: repeating-linear-gradient(
      to bottom,
      var(--gold) 0 11.111%,
      var(--green) 11.111% 22.222%,
      var(--red) 22.222% 33.333%
    );
    box-shadow: 0 0.5rem 1rem rgb(35 32 24 / 22%);
  }

  .map-card figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.2rem 0.05rem;
    color: #514831;
    font-family: var(--serif);
    font-size: 0.78rem;
    font-style: italic;
  }

  .map-card figcaption small {
    font-family: var(--sans);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .calendar-wrap {
    position: relative;
    scroll-margin-top: 1rem;
  }

  @media (max-width: 50rem) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2.5rem;
      padding-bottom: 4.5rem;
    }

    .map-card {
      width: min(100%, 35rem);
      justify-self: center;
      rotate: 0.6deg;
    }
  }
</style>
