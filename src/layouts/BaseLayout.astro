---
import "../styles/global.css";
import { sitePath } from "../components/paths";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  eyebrow?: string;
}

const {
  title = "Det sker på Ærø",
  description = "Koncerter, møder, gudstjenester og andre offentligt annoncerede arrangementer på Ærø.",
  canonicalPath = "/",
  eyebrow,
} = Astro.props;

const siteName = "Det sker på Ærø";
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = Astro.site ? new URL(sitePath(canonicalPath), Astro.site) : undefined;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#315f45" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("has-js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#indhold">Gå til indhold</a>
    <header class="site-header">
      <div class="header-inner page-width">
        <a class="brand" href={sitePath("/")} aria-label="Det sker på Ærø, forside">
          <span class="brand-mark" aria-hidden="true"></span>
          <span><small>Det sker</small>på Ærø</span>
        </a>
        <nav aria-label="Primær navigation">
          <a href={sitePath("/")}>Kalender</a>
          <a href={sitePath("/arrangoerer/")}>Arrangører</a>
          <a href={sitePath("/kilder/")}>Kilder</a>
          <a class="nav-submit" href={sitePath("/indsend/")}>Indsend arrangement</a>
        </nav>
      </div>
    </header>

    <main id="indhold">
      {eyebrow && <p class="page-width page-eyebrow">{eyebrow}</p>}
      <slot />
    </main>

    <footer class="site-footer">
      <img
        class="footer-map"
        src={sitePath("/images/aero-blaeu-1665.webp")}
        alt=""
        loading="lazy"
        aria-hidden="true"
      />
      <div class="page-width footer-grid">
        <div>
          <p class="footer-title">Det sker på Ærø</p>
          <p>En enkel, lokal oversigt over det, vi kan mødes om.</p>
          <p class="map-credit">
            Kort: <a href="https://commons.wikimedia.org/wiki/File:Arroe_by_Blaeu_1665_(cropped).jpg">Joan Blaeu, 1665</a>
            · public domain
          </p>
        </div>
        <nav aria-label="Sidefod">
          <a href={sitePath("/")}>Kalender</a>
          <a href={sitePath("/kilder/")}>Kilder</a>
          <a href={sitePath("/indsend/")}>Få et arrangement med</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
